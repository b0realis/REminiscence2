include(FetchContent)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(SDL_TEST OFF CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
if(ANDROID)
    set(SDL_SHARED ON CACHE BOOL "" FORCE)
    set(SDL_STATIC OFF CACHE BOOL "" FORCE)
else()
    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
    set(SDL_STATIC ON CACHE BOOL "" FORCE)
endif()
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/packaging/dependencies.json" dependency_pins)
foreach(dependency IN ITEMS SDL2 zlib)
    string(JSON dependency_url GET "${dependency_pins}" ${dependency} url)
    string(JSON dependency_sha GET "${dependency_pins}" ${dependency} sha256)
    FetchContent_Declare(${dependency} URL "${dependency_url}" URL_HASH "SHA256=${dependency_sha}")
endforeach()
FetchContent_MakeAvailable(SDL2)
if(NOT TARGET SDL2::SDL2)
    add_library(SDL2::SDL2 ALIAS SDL2-static)
endif()
set(ZLIB_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
FetchContent_MakeAvailable(zlib)
if(NOT TARGET ZLIB::ZLIB)
    add_library(ZLIB::ZLIB ALIAS zlibstatic)
endif()
# zlib 1.3.1 predates modern usage requirements.
target_include_directories(zlibstatic PUBLIC "${zlib_SOURCE_DIR}" "${zlib_BINARY_DIR}")
