file(MAKE_DIRECTORY "${TEST_ROOT}/empty data")

function(check_cli expected_status expected_text)
    execute_process(COMMAND "${ENGINE}" ${ARGN}
        WORKING_DIRECTORY "${TEST_ROOT}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors
        TIMEOUT 5)
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "${ARGN}: expected status ${expected_status}, got ${status}\n${output}${errors}")
    endif()
    if(NOT "${output}${errors}" MATCHES "${expected_text}")
        message(FATAL_ERROR "${ARGN}: missing '${expected_text}'\n${output}${errors}")
    endif()
    set(last_cli_output "${output}" PARENT_SCOPE)
    set(last_cli_errors "${errors}" PARENT_SCOPE)
endfunction()

check_cli(0 "Usage:" --help)
set(long_help "${last_cli_output}")
check_cli(0 "Usage:" -h)
if(NOT "${last_cli_output}" STREQUAL "${long_help}" OR NOT "${last_cli_errors}" STREQUAL "")
    message(FATAL_ERROR "-h must show the same guide as --help, without diagnostics")
endif()
# Help must remain usable before configuration, assets or devices are opened.
check_cli(0 "CONFIGURATION SWITCHES" "--config=${TEST_ROOT}/missing.cfg" -h)
if(NOT DEFINED ENGINE_VERSION)
    message(FATAL_ERROR "ENGINE_VERSION must match the version.h build metadata")
endif()
string(REPLACE "." "\\." escaped_version "${ENGINE_VERSION}")
check_cli(0 "REminiscence2 ${escaped_version}" --version)
check_cli(1 "Usage:" --not-a-real-option)
check_cli(1 "Invalid level" --levelnum=-1)
check_cli(1 "Invalid level" --levelnum=7)
check_cli(1 "Invalid level" --levelnum=2garbage)
check_cli(1 "Invalid level" --levelnum=99999999999999999999999)
check_cli(1 "Invalid language" --language=unknown)
check_cli(1 "Invalid widescreen mode" --widescreen=unknown)
check_cli(1 "Unable to read configuration" "--config=${TEST_ROOT}/missing.cfg")
check_cli(1 "Unexpected argument" unexpected extra)
check_cli(1 "No supported Flashback game data found")
check_cli(1 "No supported Flashback game data" --widescreen=none)
check_cli(1 "No supported Flashback game data" --widescreen=adjacent-blur --language=ru --levelnum=6)
check_cli(1 "empty data" "${TEST_ROOT}/empty data")

# Config must load even when the executable is invoked through an absolute path.
file(WRITE "${TEST_ROOT}/fb.cfg" "default_config_sentinel=true\n")
check_cli(1 "Unhandled option 'default_config_sentinel'")
file(WRITE "${TEST_ROOT}/custom config.cfg" "explicit_config_sentinel=true\n")
check_cli(1 "Unhandled option 'explicit_config_sentinel'" "--config=${TEST_ROOT}/custom config.cfg")

check_cli(1 "Invalid output rate" --outputrate=0)
check_cli(1 "Invalid output rate" --outputrate=48000oops)
check_cli(1 "Invalid output rate" --outputrate=192001)
check_cli(1 "Invalid output rate" --outputrate=-1)
check_cli(1 "Invalid debug mask" --debug=-1)
check_cli(1 "Invalid cheats mask" --cheats=18446744073709551616)
check_cli(1 "No supported Flashback game data" --outputrate=48000 --debug=0x40 --maximized)

check_cli(1 "Invalid MIDI driver" --mididriver=unknown)
check_cli(1 "No supported Flashback game data" --mididriver=adlib)
check_cli(1 "No supported Flashback game data" --mididriver=none)

check_cli(1 "Invalid cutscene selection" --play-cutscene=intro:-1)
check_cli(1 "Invalid cutscene selection" --play-cutscene=../intro)
check_cli(1 "Invalid cutscene selection" --play-cutscene=intro:65536)
check_cli(1 "cannot be combined" --list-cutscenes --play-cutscene=intro)
check_cli(1 "No supported Flashback game data" --list-cutscenes)
check_cli(1 "No supported Flashback game data" --play-cutscene=intro:0)
check_cli(1 "No supported Flashback game data" --no-preferences)
check_cli(1 "No supported Flashback game data" --portable)
file(MAKE_DIRECTORY "${TEST_ROOT}/profile saves")
file(WRITE "${TEST_ROOT}/profile saves/preferences.cfg" "version=99\nmaster_volume=1\n")
check_cli(1 "unsupported preferences version" "--savepath=${TEST_ROOT}/profile saves")
check_cli(1 "No supported Flashback game data" "--savepath=${TEST_ROOT}/profile saves" --no-preferences)
if("${last_cli_errors}" MATCHES "unsupported preferences")
    message(FATAL_ERROR "--no-preferences must bypass saved profile parsing")
endif()

message(STATUS "CLI checks passed")

# A relocated one-click executable discovers assets beside itself, independent
# of the terminal/Explorer working directory. No SDL devices or real data needed.
set(package "${TEST_ROOT}/isolated package")
file(MAKE_DIRECTORY "${package}/assets")
file(COPY "${ENGINE}" DESTINATION "${package}")
get_filename_component(engine_name "${ENGINE}" NAME)
set(ENGINE "${package}/${engine_name}")
check_cli(1 "No supported Flashback game data found in '.*isolated package.*assets'" --no-preferences)
check_cli(1 "No supported Flashback game data found in '.*isolated package.*assets'" --portable)
if(EXISTS "${package}/SAVE")
    message(FATAL_ERROR "Missing-data startup must not create portable saves")
endif()
